# Local dashboard binds loopback only. Do not expose unsigned public HTTP.
WEBUI_PORT=18000
WEB_ADMIN_USER=admin
# Random administrator password is generated in web identity volume.
# Retrieve: docker compose exec web cat /identity/admin-password

# Explicit deterministic development provider; never real external inference.
# Set 0 and configure models in dashboard for a real OpenAI-compatible provider.
LLM_MOCK=1

# Host identity is descriptive locality, not authorization.
MESH_HOST_ID=local
# Docker socket group on Linux: stat -c %g /var/run/docker.sock
# Docker Desktop defaults to GID 0.
DOCKER_GID=0

# Optional relay profile. Public cross-host endpoint must use HTTPS.
RELAY_PORT=18088
RELAY_ADVERTISE=http://relay:8080

# Advanced per-node environment (set in Compose override, not shared keys):
# MESH_SEEDS=http://peer-a:8080,http://peer-b:8080
# MESH_INTERVAL=2s
# MESH_TTL=10s
# MESH_TLS_CERT=/run/tls/node.crt
# MESH_TLS_KEY=/run/tls/node.key
# MESH_CA_FILE=/run/tls/ca.crt
# MESH_RELAYS=https://relay.example.net
# MESH_ALLOW_PLAINTEXT_SENSITIVE=1 # isolated bridge development only
